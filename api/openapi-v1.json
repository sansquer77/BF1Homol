    "/api/v1/logs/export": {
      "get": {
        "description": "Gera JSONL gzip em memória; não aceita nomes ou caminhos do cliente.",
        "operationId": "export_logs_api_v1_logs_export_get",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
