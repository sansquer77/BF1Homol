# Exemplo para a autenticação OIDC nativa do Streamlit.
# Não versionar secrets.toml nem credenciais reais.
[auth]
redirect_uri = "https://app.exemplo.com/oauth2callback"
cookie_secret = "gere-um-segredo-aleatorio-longo"
client_id = "client-id-do-provedor"
client_secret = "client-secret-do-provedor"
server_metadata_url = "https://provedor/.well-known/openid-configuration"
